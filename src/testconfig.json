{
    "platform": {
        "execution": {
            "parallel": false
        }
    },
    "codeCoverage": {
        "Configuration": {
            "Format": "cobertura",
            "IncludeTestAssembly": false,
            "CodeCoverage": {
                "ModulePaths": {
                    "Exclude": [
                        "(^|.*[/\\\\])[^/\\\\]*Tests[^/\\\\]*\\.(dll|exe)$",
                        "(^|.*[/\\\\])[^/\\\\]*TestRunner[^/\\\\]*\\.(dll|exe)$",
                        "(^|.*[/\\\\])[^/\\\\]*Benchmarks[^/\\\\]*\\.(dll|exe)$",
                        "(^|.*[/\\\\])[^/\\\\]*\\.Example[^/\\\\]*\\.(dll|exe)$"
                    ]
                },
                "Sources": {
                    "Exclude": [
                        ".*[/\\\\]obj[/\\\\].*"
                    ]
                }
            }
        }
    }
}
